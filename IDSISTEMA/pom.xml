<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         enoc/controladores-escritura
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<!-- NOTA: Se cambió a 3.2.5 porque la 4.1.1 del PDF no existe en Maven -->
		<version>3.2.5</version>
		<relativePath/> 
	</parent>
	
	<groupId>mx.edu.uacm.is.slt.as</groupId>
	<artifactId>IDSISTEMA</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>IDSISTEMA</name>
	<description>Sistema intermediario de polizas</description>
	
	<properties>
		<!-- NOTA: Se cambió a 21 porque Java 25 aún no sale. Si tienes Java 17, cámbialo a 17 -->
		<java.version>21</java.version>
	</properties>
	
	<dependencies>
		<!-- Spring Web: Para crear los Controladores REST -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- Spring Data JPA: Para los Modelos e Hibernate -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- Driver de PostgreSQL -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Spring Boot Test -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
